# Large model artifacts (keep dir structure with .gitkeep)
models/checkpoints/*.pt
models/checkpoints/*.pth
models/checkpoints/*.ckpt
models/onnx/*.onnx
!models/checkpoints/.gitkeep
!models/onnx/.gitkeep

# Logs and recording dumps
*.log
recordings/
logs/
errors.log

# Raw dataset files and generated manifests
data/raw/
data/manifests/*.json
data/manifests/*.csv
!data/manifests/.gitkeep
!data/raw/.gitkeep
