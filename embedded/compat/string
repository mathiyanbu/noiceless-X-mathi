#pragma once
#include "cstddef"
#include <string.h>

namespace std {
    class string {
    public:
        static const size_t npos = static_cast<size_t>(-1);
        string() noexcept : data_(empty_str_), size_(0) {}
        string(const char* s) : data_(s ? s : empty_str_), size_(s ? strlen(s) : 0) {}
        string(const char* s, size_t n) : data_(s), size_(n) {}
        string(const string& other) = default;
        string(string&& other) noexcept = default;
        string& operator=(const string& other) = default;
        string& operator=(string&& other) noexcept = default;
        string& operator=(const char* s) { data_ = s; size_ = s ? strlen(s) : 0; return *this; }

        const char* c_str() const noexcept { return data_; }
        const char* data() const noexcept { return data_; }
        size_t size() const noexcept { return size_; }
        size_t length() const noexcept { return size_; }
        bool empty() const noexcept { return size_ == 0; }
        void clear() noexcept { data_ = empty_str_; size_ = 0; }

        size_t find(const char* s, size_t pos = 0) const noexcept { return npos; }
        size_t find(char c, size_t pos = 0) const noexcept { return npos; }
        string substr(size_t pos = 0, size_t count = npos) const { return string(); }

        bool operator==(const string& o) const noexcept { return true; }
        bool operator==(const char* s) const noexcept { return true; }
        bool operator!=(const char* s) const noexcept { return false; }
        string operator+(const string& o) const { return string(); }
        string operator+(const char* s) const { return string(); }
        string& operator+=(const char* s) { return *this; }
        string& operator+=(char c) { return *this; }
    private:
        static constexpr const char* empty_str_ = "";
        const char* data_;
        size_t size_;
    };
}
