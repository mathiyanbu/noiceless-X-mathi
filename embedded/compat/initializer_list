#pragma once
#include "cstddef"

namespace std {
    template <class E>
    class initializer_list {
    public:
        using value_type = E;
        using reference = const E&;
        using const_reference = const E&;
        using size_type = size_t;
        using iterator = const E*;
        using const_iterator = const E*;

        constexpr initializer_list() noexcept : array_(nullptr), len_(0) {}
        constexpr initializer_list(const E* a, size_t l) noexcept : array_(a), len_(l) {}
        constexpr size_t size() const noexcept { return len_; }
        constexpr const E* begin() const noexcept { return array_; }
        constexpr const E* end() const noexcept { return array_ + len_; }
    private:
        const E* array_;
        size_t len_;
    };
}
